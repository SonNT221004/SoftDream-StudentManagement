@page "/dashboard"
@using StudentWeb.Models
@using StudentWeb.Resilience
@using StudentWeb.Services.Interface
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<GrpcConnectionPanel Connection="Connection"
                     OnRetry="FirstLoadChartAsync" />
@if (Connection.IsUnavailable)
{
    <div class="text-center text-muted py-5">
        <p>Unable to load analytics.</p>
    </div>
}
else if (isLoading || Connection.IsRetrying)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2 mb-0">Connecting to server...</p>
    </div>
}
else
{
    <PageContainer>
    <Row Gutter="16" Style="margin-bottom: 24px;">
        
            <Card Bordered="false" >
                <Statistic Title="Number of Students" Value="@totalStudents" Suffix="Students">
                    <PrefixTemplate>
                        <Icon Type="user" Style="color: #1890ff; margin-right: 8px;" />
                    </PrefixTemplate>
                </Statistic>
            </Card>
        
     
            <Card Bordered="false">
                <Statistic Title="Number of Teachers" Value="@totalTeachers" Suffix="Teachers">
                    <PrefixTemplate>
                        <Icon Type="team" Style="color: #52c41a; margin-right: 8px;" />
                    </PrefixTemplate>
                </Statistic>
            </Card>
        
            <Card Bordered="false">
                <Statistic Title="Number of Classes" Value="@totalClasses" Suffix="Classes">
                    <PrefixTemplate>
                        <Icon Type="book" Style="color: #faad14; margin-right: 8px;" />
                    </PrefixTemplate>
                </Statistic>
            </Card>
        
            <Card Bordered="false">
            <Statistic Title="Average class size" Value="@avgStudentsPerClass" Precision="1" Suffix="Student/Class">
                    <PrefixTemplate>
                        <Icon Type="bar-chart" Style="color: #f5222d; margin-right: 8px;" />
                    </PrefixTemplate>
                </Statistic>
            </Card>
        
    </Row>
</PageContainer>
    <p>Number of Students categorized by Locations</p>
    <Pie @key="studentAddressInfo"
         Data="studentAddressInfo"
         Config="configForPie" />

    <p>Number of Classes categorized by Teachers</p>
    <Bar @key="teacherClassInfo"
         Data="teacherClassInfo"
         Config="configForBar" />
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Error</h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="@(() => CloseErrorPopup())">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">@errorMessage</p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-danger"
                            @onclick="@(() => CloseErrorPopup())">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}