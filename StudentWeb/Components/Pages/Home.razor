@page "/"
@using StudentWeb.Models
@using StudentWeb.Resilience
@using StudentWeb.Services.Interface
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Students</PageTitle>

<GrpcConnectionPanel Connection="Connection"
                     OnRetry="FirstLoadAllAsync" />
@if (Connection.IsUnavailable && students.Count == 0)
{
    <div class="text-center text-muted py-5">
        <p>Unable to load student list.</p>
    </div>
}
else if (isLoading || Connection.IsRetrying)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2 mb-0">Connecting to server...</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-hover mb-3">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Date of Birth</th>
                        <th>Address</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var student in students)
                    {
                        <tr class="student-row" @onclick="@(() => ShowStudentDetailAsync(student))">
                            <td>@student.Id</td>
                            <td>@student.Name</td>
                            <td>@student.DateOfBirth.ToString("dd/MM/yyyy")</td>
                            <td>@student.Address</td>
                        </tr>
                    }
                </tbody>
            </table>
            <nav class="d-flex justify-content-between align-items-center mb-3">
                <small class="text-muted">
                    Page @currentPage / @totalPages
                </small>
                <ul class="pagination mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : null)">
                        <button type="button"
                                class="page-link"
                                disabled="@(currentPage <= 1)"
                                @onclick="PreviousPageAsync">
                            Previous
                        </button>
                    </li>
                    @for (var page = 1; page <= totalPages; page++)
                    {
                        var pageNumber = page;
                        <li class="page-item @(pageNumber == currentPage ? "active" : null)">
                            <button type="button"
                                    class="page-link"
                                    @onclick="@(() => GoToPageAsync(pageNumber))">
                                @pageNumber
                            </button>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : null)">
                        <button type="button"
                                class="page-link"
                                disabled="@(currentPage >= totalPages)"
                                @onclick="NextPageAsync">
                            Next
                        </button>
                    </li>
                </ul>
            </nav>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-primary" @onclick="OpenAddForm">Add</button>
                <button class="btn btn-success" @onclick="ArrangeByName">@arrangeButtonName</button>
            </div>
        </div>
    </div>
}

@if (selectedStudent is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Student Details</h5>
                    <button type="button" class="btn-close" @onclick="CloseStudentDetailPopup"></button>
                </div>

                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@selectedStudent.Id</dd>

                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@selectedStudent.Name</dd>

                        <dt class="col-sm-3">Date of Birth</dt>
                        <dd class="col-sm-9">@selectedStudent.DateOfBirth.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3">Address</dt>
                        <dd class="col-sm-9">@selectedStudent.Address</dd>
                    </dl>

                    <h6>Classes</h6>

                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Teacher Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var studentClass in selectedStudent.Classes)
                            {
                                <tr>
                                    <td>@studentClass.Id</td>
                                    <td>@studentClass.Name</td>
                                    <td>@(studentClass.Teacher?.Name ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-warning" @onclick="OpenUpdateForm">Edit</button>
                    <button class="btn btn-danger" @onclick="DeleteStudent">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}


@if (updatingStudent is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <form @onsubmit="@(() => EditStudent())">
                    <div class="modal-header">
                        <h5 class="modal-title">Update Student</h5>

                        <button type="button"
                                class="btn-close"
                                @onclick="@(() => CloseUpdateForm())">
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">ID</label>
                            <input class="form-control"
                                   value="@updatingStudent.Id"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control"
                                   @bind="updatingStudent.Name"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Date of Birth</label>
                            <input type="date"
                                   class="form-control"
                                   @bind="updatingStudent.DateOfBirth"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <input class="form-control"
                                   @bind="updatingStudent.Address"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Classes</label>

                            <select class="form-select"
                                    multiple
                                    size="5"
                                    @bind="updatingStudent.ClassIds">
                                @foreach (var classItem in availableClasses)
                                {
                                    <option value="@classItem.Id">
                                        @classItem.Name —
                                        @(classItem.Teacher?.Name ?? "N/A")
                                    </option>
                                }
                            </select>

                            <small class="text-muted">
                                Hold Ctrl to choose multiple classes.
                            </small>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="@(() => CloseUpdateForm())">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-success">
                            Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@if (isAddFormVisible)
{
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form @onsubmit="AddStudent">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Student</h5>
                        <button type="button" class="btn-close" @onclick="CloseAddForm"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control"
                                   @bind="newStudent.Name"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Date of Birth</label>
                            <input type="date"
                                   class="form-control"
                                   @bind="newStudent.DateOfBirth"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <input class="form-control"
                                   @bind="newStudent.Address"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Classes</label>
                            <select class="form-select"
                                    multiple
                                    size="5"
                                    @bind="newStudent.ClassIds">
                                @foreach (var classItem in availableClasses)
                                {
                                    <option value="@classItem.Id">
                                        @classItem.Name — @(classItem.Teacher?.Name ?? "N/A")
                                    </option>
                                }
                            </select>
                            <small class="text-muted">
                                Hold Ctrl to choose multiple classes
                            </small>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CloseAddForm">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}


@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Error</h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="@(() => CloseErrorPopup())">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">@errorMessage</p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-danger"
                            @onclick="@(() => CloseErrorPopup())">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}


@if (!string.IsNullOrWhiteSpace(succesMessage))
{
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Success</h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="@(() => CloseSuccessPopup())">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">@succesMessage</p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-success"
                            @onclick="@(() => CloseSuccessPopup())">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}


<style>
    .student-row {
        cursor: pointer;
    }

        .student-row:hover {
            background-color: #f2f6ff;
        }
</style>