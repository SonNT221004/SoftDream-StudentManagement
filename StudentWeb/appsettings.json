{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "StudentWeb.GrpcRetry": "Information",
      "Polly": "Warning",
      "Microsoft.Extensions.Http.Resilience": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Grpc": {
    "ServerAddress": "https://localhost:5000",
    "Retry": {
      "MaxRetryAttempts": 3,
      "DelayMilliseconds": 9000
    }
  }
}
